{
  "name": "pioniersstudenten",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun --env-file=.env next dev",
    "dev:test": "bun --bun --env-file=.env.test next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run ./src/drizzle/seed.ts",
    "test:setup": "bun --env-file=.env.test drizzle-kit migrate && bun test:seed",
    "test:seed": "bun --env-file=.env.test run ./src/drizzle/seed.ts",
    "test": "bun test --env-file=.env.test"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@faker-js/faker": "^10.3.0",
    "@hugeicons/core-free-icons": "4.2.0",
    "@hugeicons/react": "1.1.6",
    "better-auth": "^1.4.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "config": "^4.2.0",
    "dayjs": "1.11.21",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "4.11.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.7",
    "@types/config": "^3.3.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/winston": "^2.4.4",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
